# Copy to .env and fill in. .env is git-ignored - never commit it.

# --- Slack (api.slack.com/apps -> your app) ---
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information -> App-Level Tokens (scope: connections:write)

# --- Claude API (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Bot behavior ---
POLICY_MODE=redact                # monitor = log only | redact = strip identifiers | block = refuse PHI/injection
CONTEXT_MESSAGES=30               # recent channel messages given to Claude as context (0 = none)
AUDIT_LOCAL_PATH=audit_events.jsonl

# --- Sentinel / Logs Ingestion API (printed by infra/setup-sentinel-ingestion.ps1) ---
LOGS_INGESTION_ENDPOINT=https://dcr-claude-audit-xxxx.eastus2-1.ingest.monitor.azure.com
DCR_IMMUTABLE_ID=dcr-00000000000000000000000000000000
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
